# --- Gmail (IMAP) ---
# Cuenta que recibe la newsletter de Yelo
GMAIL_USER=tu_correo@gmail.com
# Contraseña de aplicación de Google (16 letras, NO tu contraseña normal)
# https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos)
GMAIL_APP_PASSWORD=

# Texto que debe aparecer en el remitente de los correos de Yelo
YELO_FROM=yelo
# Solo mira correos de los últimos N días
DIAS_ATRAS=7

# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# Tu chat id (se obtiene con: python main.py chat-id)
TELEGRAM_CHAT_ID=

# --- Xceed ---
TITULAR_NOMBRE=
TITULAR_APELLIDOS=
XCEED_ENTRADAS=6

# --- Bucle ---
# Cada cuántos segundos revisa el correo en modo "run"
INTERVALO_SEGUNDOS=60
